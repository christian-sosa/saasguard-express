# Google sign-in (optional). Without a client ID the app runs without login.
# Create an OAuth client of type "Web application" in Google Cloud Console and add the
# authorized JavaScript origins (http://localhost:5173 and https://saasguard-express.vercel.app).
VITE_GOOGLE_CLIENT_ID=
# Optional: only accept accounts of this Google Workspace domain (hd claim).
VITE_GOOGLE_ALLOWED_DOMAIN=
