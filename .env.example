# Autenticación de servidor en Vercel y en Vite local con esta clave configurada.
# Usar 32 bytes aleatorios codificados como 64 dígitos hexadecimales.
SAASGUARD_SESSION_SECRET=
# JSON con los campos username, email, name, role, salt y hash por cuenta.
# salt es aleatorio en hexadecimal. hash es scrypt de 64 bytes en hexadecimal.
# Roles: admin, it, people, finance, viewer. Guardar los valores sólo en el entorno.
SAASGUARD_PASSWORD_USERS=[]

# Google opcional. Configurar un cliente web con el origen de la aplicación autorizado.
SAASGUARD_GOOGLE_CLIENT_ID=
# Formato email:rol,email:rol. Estos valores se leen sólo en el servidor.
SAASGUARD_GOOGLE_ALLOWED_EMAILS=
# Un dominio de Google Workspace autorizado recibe el rol viewer por defecto.
SAASGUARD_GOOGLE_ALLOWED_DOMAIN=

# Sólo para pruebas locales del modo demo sin autenticación de servidor.
# Usar identificadores y correos ficticios. Vite expone estas variables al navegador.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_ALLOWED_EMAILS=
VITE_GOOGLE_ALLOWED_DOMAIN=
