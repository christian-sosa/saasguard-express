      "employees": "nomina.csv",
      "licenses": [
        "licencias.csv"
      ],
      "expected": {
        "employeeCount": 4,
        "totalLicenses": 7,
        "matchedCount": 4,
        "candidateCount": 3,
        "knownCostCount": 2,
        "unknownCostCount": 1,
        "zeroCostCandidateCount": 1,
        "potentialSavingsCents": 1550,
        "selectedCount": 0
